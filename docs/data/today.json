  "headline": "Tre Jones Is Carrying Suggs To Be You",
  "subhead": "The swap that nobody noticed is the only reason this matchup isn't a coin flip.",
  "zingers": [
   {
    "team": "Suggs to be you",
    "line": "Tre Jones, added into an open roster spot, drops 17 assists in two games and flips PTS and AST; without him this is 5-5."
   },
   {
    "team": "Gopher Gold",
    "line": "Devin Vassell's 34 points and 5 steals back up the pickup, but dropping Brayden Burries for Matisse Thybulle gifted BrookynDynasty a 40-point guy."
   },
   {
    "team": "BrookynDynasty",
    "line": "Brayden Burries, the guy Gopher Gold cut, now has 40 points and 15 defensive boards for BrookynDynasty. Brutal for the guy who dropped him."
   },
   {
    "team": "theInfamous",
    "line": "Mo Bamba and Jaime Jaquez Jr. were added, Jaxson Hayes went 5-for-5 after the drop, and theInfamous still trails Gopher Gold 4-6."
