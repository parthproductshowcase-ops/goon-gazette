 "week_copy": {
  "headline": "Gopher Gold Bury theInfamous Early",
  "subhead": "Nine categories to two, and theInfamous have five fewer starts left to climb out.",
  "zingers": [
   {
    "team": "MONSTARS \u2604\ufe0f",
    "line": "De'Andre Hunter's 15 points and 8 assists flipped AST and ST, so without the Jerami Grant drop MONSTARS trail 4-5 to Thug Life."
   },
   {
    "team": "theInfamous",
    "line": "Gopher Gold lead 9-2, theInfamous have 25 starts left to Gopher's 30, and Tatum's 23 tonight can't fix that."
   },
   {
    "team": "BrookynDynasty",
    "line": "The Brayden Burries pickup is swinging the matchup, and Da Don Da Beard & Da Klaw are 4 starts short of an answer."
   },
   {
    "team": "Da Don Da Beard & Da Klaw",
    "line": "Trailing 3-8 with the night's best line from Ausar Thompson and Daniss Jenkins, and still losing in every way that counts."
   },
   {
    "team": "Gopher Gold",
    "line": "Devin Vassell hit four threes after replacing Dean Wade, who put up 2 points on 0-for-5, and the drop made the swap look smart."
   },
   {
    "team": "Suggs to be you",
    "line": "Tre Jones landed in an open roster spot and gave them 16 points and 9 assists to flip PTS against Zero Fox Given."
   },
   {
    "team": "Adam Silver Dez Nuts",
    "line": "They led 7-4 an update ago, now it's 5-5, and Coulibaly's 0-for-3 is helping White Mambas close in."
   }
