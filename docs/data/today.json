 "week_copy": {
  "headline": "Pickups Are Carrying Three Different Teams",
  "subhead": "theInfamous, MONSTARS and Adam Silver Dez Nuts are all ahead of where their old rosters would have left them.",
  "zingers": [
   {
    "team": "MONSTARS \u2604\ufe0f",
    "line": "De'Andre Hunter has 30 points, 13 defensive boards and 11 assists in two games, and the Jerami Grant drop flipped 3PTM and PTS."
   },
   {
    "team": "theInfamous",
    "line": "Kenrich Williams dropped 13 points and three triples, Mo Bamba chipped in, and the Cameron Johnson and Jaxson Hayes cuts turned a 3-6 loss into 5-4."
   },
   {
    "team": "Adam Silver Dez Nuts",
    "line": "Jalen Suggs and Julian Champagnie turned a 4-6 deficit into a 6-3 lead over White Mambas, with Tari Eason also in the mix."
   },
   {
    "team": "Zero Fox Given",
    "line": "Jrue Holiday is swinging the matchup, and Zero Fox Given leads Suggs to be you 7-3 after snatching AST tonight."
   },
   {
    "team": "Suggs to be you",
    "line": "Down 3-7 with 21 starts left, a two-start edge, which is nice if the roster were not busy losing FG% and FT%."
   },
   {
    "team": "Thug Life",
    "line": "Jaden McDaniels is the week's top scorer, yet Thug Life leads MONSTARS by one and has 21 starts left to MONSTARS' 17."
   },
   {
    "team": "BrookynDynasty",
    "line": "Brayden Burries and Jared McCain combined for 12 points on 4-17 shooting tonight, and BrookynDynasty still leads Da Don Da Beard & Da Klaw 8-3."
   }
  ]
 },
